# WattGap needs no API keys: prices are committed CSVs from ERCOT's public MIS (see data/PROVENANCE.md).

# Fleet secret. Each battery's HMAC command key is derived from it (HMAC-SHA256 of "device:<id>").
# If unset, WattGap generates an ephemeral dev secret at startup and logs a warning.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
WATTGAP_FLEET_SECRET=replace-with-64-hex-chars
